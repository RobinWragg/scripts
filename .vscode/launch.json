    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'scripts'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=scripts"
                ],
                "filter": {
                    "name": "scripts",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'shrink_names'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=shrink_names",
                    "--package=scripts"
                ],
                "filter": {
                    "name": "shrink_names",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
